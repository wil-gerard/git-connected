# Local development example.
# Copy this file to server/.env and replace placeholder values.
# Production values should live in your hosting provider's environment settings,
# not in server/.env.

NODE_ENV=development
PORT=4000

# Local MongoDB example:
# MONGODB_URL=mongodb://127.0.0.1:27017/git-connected
MONGODB_URL=mongodb://127.0.0.1:27017/git-connected

# Used by OAuth redirects and CORS in development.
FRONTEND_ORIGIN_URL=http://localhost:3000

# Generate a local-only value with:
# openssl rand -hex 32
SESSION_SECRET=replace-with-local-session-secret

# Discord OAuth app
# Callback URL: http://localhost:4000/api/auth/discord/callback
DISCORD_CLIENT_ID=replace-with-local-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-local-discord-client-secret

# GitHub OAuth app
# Callback URL: http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=replace-with-local-github-client-id
GITHUB_CLIENT_SECRET=replace-with-local-github-client-secret
